# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Local Postgres for Checkpoint 4. `npm run db:migrate` writes DATABASE_URL into .env.
# The app role must not be a superuser. Do not put a service-role key in client code.
# NEXT_PUBLIC_SUPABASE_* stays empty until this project is pointed at hosted Supabase.
# Hosted Supabase already owns the auth schema, so do not run scripts/sql/001_local_auth.sql there.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — required from Checkpoint 6. Server-side only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Speech provider — required from Checkpoint 5. Server-side only.
STT_PROVIDER=
DEEPGRAM_API_KEY=

# Optional realtime voice. Not the MVP default.
REALTIME_VOICE_PROVIDER=
OPENAI_API_KEY=

# Optional payments. Do not enable checkout until eligibility is verified.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
